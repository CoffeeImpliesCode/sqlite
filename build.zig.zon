// SPDX-License-Identifier: LicenseRef-PublicDomain
// See FORK-LICENSE.md for what that identifier covers.
.{
    // The package id, the name a dependent writes in its dependency map, the
    // one registered module (`dep.module("sqlite3")`) and the C artifact
    // (`dep.artifact("sqlite3")`) are one string on purpose.
    //
    // It is upstream's library name and not this repository's directory name,
    // and the reason is what it has to be at link time: Zig emits
    // `libsqlite3.a` for an artifact called `sqlite3`, which is the file name
    // upstream's own build produces (`upstream/main.mk`) and the one a C
    // consumer's `-lsqlite3` needs - upstream's own `sqlite3.pc.in:14` writes
    // exactly that. A package called `sqlite` would emit `libsqlite.a` and
    // every C consumer of this tree would have to write `-lsqlite`, a link line
    // no upstream build answers. The repository directory is `sqlite/`; the
    // package, the module, the artifact and the archive are `sqlite3`.
    .name = .sqlite3,
    .fingerprint = 0x6edcd71155f49d5f,
    // Upstream's own release, read out of `src/sqlite3.h:149`
    // (`SQLITE_VERSION "3.53.4"`) and confirmed against `upstream/VERSION`,
    // which holds the three characters `3.53`. This is the version of the C
    // library this package builds, not a version of the wrapper. `build.zig`
    // compares it against the same constant read out of the header and refuses
    // to configure when the two disagree, so this string, the pkg-config
    // `Version:` field and the shared object's file name cannot describe three
    // different releases.
    .version = "3.53.4",
    // `.fingerprint` is deliberately absent.
    //
    // The Zig toolchain generates it when a package is first created and the
    // documented way to replace one that is wrong is to delete the field and
    // run `zig build` - the template the toolchain itself ships for a new
    // package says so at the line this comment sits on: "This field is
    // generated by the Zig toolchain when the package is first created, and
    // then *never changes*" and "this id should be regenerated (delete the
    // field and run `zig build`)".
    //
    // A value written by hand here would be an identifier this repository
    // cannot derive from anything, which is exactly what `AGENTS.md` rule 3
    // forbids, and a wrong one is a security property rather than a comment:
    // the fingerprint is what distinguishes this package from another one that
    // claims the same name. The first `zig build` writes the correct value and
    // the driver commits it in the same change; `FORK-NOTES.md` carries that as
    // an open item rather than as a done one.
    .minimum_zig_version = "0.16.0",
    // Nothing is fetched: the C library is this repository's own source, and
    // the facade, tests, example, consumer and runtime table import only what is
    // compiled here. SQLite's release is the two archives already unpacked into
    // `src/`, `upstream/` and `test/`.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        // The cross-test harness profile for this package. It is a file in the
        // package because it is how this package declares what its
        // cross-platform gate is: `cross-test` discovers it by name from the
        // package root, and it is settings only - the standard `zig build test`
        // step over the full published platform matrix, no target subset and no
        // host path. Nothing in build.zig reads it.
        "cross-test.profile.sh",
        // zig/root.zig is the typed facade and zig/translate.h the aggregate
        // translation header. Both travel because a dependent reaches them
        // through `dep.module("sqlite3")`.
        "zig",
        // Upstream's amalgamation, unmodified: the whole of the
        // `sqlite-amalgamation-3530400.zip` artefact, which is four files - the
        // single library translation unit `sqlite3.c`, the shell's own `shell.c`,
        // and the two headers. There is no source list to trim and no unit to
        // add: `src/sqlite3.c:1-18` is upstream's own statement that this file
        // is all you need to compile SQLite. The whole directory travels rather
        // than a hand-picked file list so that the tree a dependent receives is
        // upstream's tree.
        "src",
        // Upstream's release metadata, from `sqlite-src-3530400.zip`: the
        // public-domain grant upstream writes in prose (`LICENSE.md`), the
        // version file, the Fossil manifest and its check-in name, the manifest
        // tag list, and the two build files that are the citation for every
        // claim about what upstream's own build does - `Makefile.in` and
        // `main.mk`, which is the one `Makefile.in:347` includes.
        //
        // These are upstream's files, not this fork's, and `build.zig` cites
        // them by line rather than paraphrasing them.
        "upstream",
        // Upstream's test suite, whole and unedited, from the same release's
        // full-source archive: 1285 files, the TCL suite under `test/*.test` and
        // `test/*.tcl`, its C harness, and the generated `fuzzdata*.db` inputs
        // that dominate the byte count. Nothing is dropped for size - dropping
        // the fuzz databases would leave a test tree that cannot run, because
        // the tests that read them are the ones that find bugs.
        //
        // This package builds and runs none of it; `build.zig`'s module comment
        // says exactly what running it would require and why this graph does not
        // have that closure. It is shipped because upstream's tests are never
        // deleted, not because this package claims to pass them.
        "test",
        "tests.zig",
        "smoke.zig",
        // The separate consumer package: proof that the published module
        // resolves from a package that did not write it, through a relative
        // path rather than a fetch.
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Upstream's own README, preserved byte for byte under this
        // repository's naming convention. Upstream's real name for it is
        // `README.md`, and that name is this fork's canonical document, so the
        // preserved copy is a separate file at the package root named
        // `README.upstream.md`. It is byte-identical to the imported
        // `upstream/README.md`, which travels under the whole-`upstream`
        // entry above rather than under this path; `tools/check-provenance.sh`
        // check 8a fails if the two ever differ.
        "README.upstream.md",
        // The provenance record, its digest list, and this fork's licence,
        // notice, changelog and working notes.
        "UPSTREAM.md",
        "UPSTREAM.sha256",
        "README.md",
        "README.zig.md",
        "NOTICE.md",
        "CHANGELOG.md",
        "FORK-NOTES.md",
        "FORK-LICENSE.md",
        // The provenance script that checks the recorded digests and the exact
        // upstream file set, and the fixture the upstream-interop gate runs:
        // `tools/fixture/aggregate.sql` and the hand-computed
        // `tools/fixture/expected.tsv` both `tests.zig` and `zig build oracle`
        // check against.
        "tools",
        // The runtime loader core the API role owns, and this library's
        // descriptor and generated dispatch beside it. It is a dependency of the
        // published module under `-Druntime`, so a dependent that fetches this
        // package must receive it; `runtime/graph.zig` is the one place
        // `createModule` substitutes for `translate.createModule()`.
        "runtime",
        // Standalone Nix packaging. `package.nix` is the one source-only
        // derivation and builds the `.static` and `.dynamic` variants of this
        // same tree; `flake.nix` exposes them; `devenv.nix`, `devenv.yaml` and
        // `.envrc` provide the canonical development shell. The lock files
        // belong to the driver and are absent from this list until they exist:
        // naming a path that is not there would make `zig fetch` hash a missing
        // entry.
        "package.nix",
        "flake.nix",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
        // .zig-cache/, zig-out/, zig-pkg/, consumer/.zig-cache/ and the Nix
        // and devenv working-tree artefacts are deliberately absent: build
        // outputs, a fetched package tree, a `result` symlink and shell state
        // are not part of a package. See .gitignore.
    },
}