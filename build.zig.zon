// SPDX-License-Identifier: LicenseRef-PublicDomain
// See FORK-LICENSE.md for what that identifier covers.
.{
    // Package, module and artifact names match upstream's `sqlite3` library.
    .name = .sqlite3,
    .fingerprint = 0x6edcd71155f49d5f,
    // Upstream SQLite release, checked against the header by build.zig.
    .version = "3.53.4",
    .minimum_zig_version = "0.16.0",
    // No external package dependencies.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        // Cross-test harness profile.
        "cross-test.profile.sh",
        // Zig facade and translation header.
        "zig",
        // Upstream amalgamation and headers.
        "src",
        // Upstream release metadata.
        "upstream",
        // Unmodified upstream test suite.
        "test",
        "tests.zig",
        "smoke.zig",
        // Standalone consumer package.
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Unmodified upstream README.
        "README.upstream.md",
        // Fork documentation and provenance records.
        "UPSTREAM.md",
        "UPSTREAM.sha256",
        "README.md",
        "README.zig.md",
        "NOTICE.md",
        "CHANGELOG.md",
        "FORK-NOTES.md",
        "FORK-LICENSE.md",
        // Provenance checker and oracle fixtures.
        "tools",
        // Runtime-loader modules.
        "runtime",
        // Nix package and development shell definitions.
        "package.nix",
        "flake.nix",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
    },
}
